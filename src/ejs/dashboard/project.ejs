<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Lua | Viewing Project</title>
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dlxrsqy04/image/upload/f_auto,q_auto/mwgwjgjq0hhhy3nsobhc">
    <link rel="stylesheet" href="https://nordcdn.net/ds/css/3.3.1/nord.min.css"  crossorigin="anonymous" />
    <script type="module" src="https://nordcdn.net/ds/components/3.19.0/index.js"crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://nordcdn.net/ds/themes/8.1.1/nord-dark.css" crossorigin="anonymous" />
    <meta name="description" content="Secure, fast Secure Whitelisting Service for Roblox. Protect your scripts with real-time threat analytics and lightning-fast performance, no source code required!">
