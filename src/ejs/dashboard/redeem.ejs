<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://nordcdn.net/ds/css/3.1.1/nord.min.css" integrity="sha384-zz2Vh/uaPtnKKnKq4a8aP/R7ybJEZD3LuwnvmLE+p42C+Zjr2R0Y+PKwdABWc61A" crossorigin="anonymous" />
    <script type="module" src="https://nordcdn.net/ds/components/3.8.0/index.js" integrity="sha384-zvZDBl7G/h/0UeesdZH1CBfL9kfoMi+5/I28m8u8yCgzJC7kohDH3I6XgaMzYnLW" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://nordcdn.net/ds/themes/8.0.1/nord-dark.css" integrity="sha384-4mfQkitA1YUssjHukrfVhopnhPw9eM2tX8Z05rZ/5NJRmDJN1fQp2gGfwydx2SzL" crossorigin="anonymous" />
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dlxrsqy04/image/upload/f_auto,q_auto/mwgwjgjq0hhhy3nsobhc">
    <title>Secure Lua | Redeem Serial</title>
    <meta name="description" content="Secure, fast Secure Whitelisting Service for Roblox. Protect your scripts with real-time threat analytics and lightning-fast performance, no source code required!">
    <meta property="og:image" content="https://res.cloudinary.com/dlxrsqy04/image/upload/f_auto,q_auto/m4zzoe6aae6lyjgfqy6v" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
</head>
<body>
    <style>
        body {
            background: var(--n-color-surface);
            margin: 0;
        }
    </style>
    
    <nord-header>
        <h1 class="n-typescale-l">Secure Lua</h1>
        <img src="https://res.cloudinary.com/dlxrsqy04/image/upload/f_auto,q_auto,h_50/mwgwjgjq0hhhy3nsobhc" alt="" srcset="">
        <nord-button href="/" slot="end">Home</nord-button>
    </nord-header>

    <nord-empty-state class="n-gap-m">
        <h2>Redeem Serial</h2>

        <nord-stack justify-content="center" direction="horizontal">
            <div style="text-align: center;">
                <nord-input name="email" autocomplete="on" id="email" label="Account Email" type="email" class="n-margin-be-m" disabled></nord-input>
                <nord-input name="serial" id="serial" label="Serial" class="n-margin-be-m"></nord-input>
                <nord-button slot="footer" variant="primary" class="n-margin-be-m" id="redeemButton" onclick="redeem()">Upgrade Account</nord-button>
            </div>
        </nord-stack>
        <div class="cf-turnstile n-margin-be-s" id="captchaWidget" data-sitekey="0x4AAAAAAAzGSMRC1hz6cKEl" data-callback="captchaCallback"></div>
    </nord-empty-state>

    <nord-divider direction="horizontal"></nord-divider>
    
    <nord-empty-state>
        <nord-stack justify-content="center" direction="horizontal">
            <a href="/tos/">Terms of Service</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="https://discord.gg/cSJwsDAtXx">Discord</a>
         </nord-stack>
    </nord-empty-state>    

    <nord-modal id="notificationModal" size="s">
        <div class="n-reset n-typeset">
            <h2 id="notificationModalTitle"></h2>
            <p id="notificationModalDescription"></p>
        </div>
        <form method="dialog" slot="footer">
            <nord-button expand variant="primary">Okay</nord-button>
        </form>
    </nord-modal>

    <script>
        const Email = document.getElementById("email");
        const serial = document.getElementById("serial");
        const redeemButton = document.getElementById("redeemButton");
        redeemButton.disabled = true;

        function OpenModal(id) {
            const element = document.getElementById(id);
            if (element.open) {
                element.close();
            } else {
                element.showModal();
            }
        }

        function CreateNotification(Title, Description) {
            notificationModalTitle.textContent = Title;
            notificationModalDescription.textContent = Description;
            OpenModal("notificationModal");
        }

        let hresponse;
        function captchaCallback(response) {
            redeemButton.disabled = false;
            hresponse = response;
        }

        async function redeem() {
            redeemButton.loading = true;
            serial.error = "";

            const packet = await fetch("/api/serials/redeem", {
                method: "POST",
                headers: {
                    ["content-type"]: "application/json",
                    ["Authorization"]: "<%-authorization%>"
                },
                body: JSON.stringify({ serial: serial.value.trim(), captcha: hresponse })
            });

            if (packet.status === 401) {
                return CreateNotification("Invalid Captcha", "Refresh the page.");
            }

            if (packet.status === 404) {
                serial.error = "Invalid Serial";
                redeemButton.loading = false;
                return;
            }

            const json = await packet.json();
            CreateNotification("Account Upgraded", `Subscription End: ${new Date(json.SubscriptionEnd).toLocaleString()}`);
            redeemButton.loading = false;
        }

        (async () => {
            const Packet = await fetch(`/api/user/<%-authorization%>`);
            UserData = await Packet.json();

            Email.value = UserData.Email;
        })();
    </script>
</body>
</html>